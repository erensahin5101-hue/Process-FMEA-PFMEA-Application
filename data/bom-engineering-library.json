{
  "schemaVersion": "1.1.0",
  "libraryId": "tyana.bom-engineering",
  "libraryVersion": "2026.07.1",
  "metadata": {
    "owner": "TYANA Q-FLOW",
    "maintainer": "Eren",
    "defaultLocale": "tr-TR",
    "status": "demonstration",
    "description": "Çok seviyeli BOM, tekrar kullanılabilir alt montaj, proses bağlantısı ve alternatif parça seçimi için mühendislik başlangıç kütüphanesi.",
    "disclaimer": "Malzeme, tolerans, tedarikçi ve proses değerleri teknik resim, şartname, müşteri özel şartı ve onaylı proses akışıyla doğrulanmadan yayınlanamaz."
  },
  "contracts": {
    "rootId": "FINISHED_GOOD",
    "bomModel": "flat-adjacency-list",
    "engineeringModel": "item-master-then-independent-bom-definitions",
    "engineeringSchemaVersion": "2.0.0",
    "itemMasterRule": "create and approve a reusable item master before referencing it from a BOM line",
    "itemMasterIdentityRule": "itemMasterId is immutable; internalCode is required and globally unique; OEM number is descriptive and may repeat",
    "bomHeaderRule": "each BOM definition belongs to one headerItemMasterId, revision and alternative",
    "bomLineRule": "each direct BOM line references an existing itemMasterId and carries quantity, unit, revision and effectivity",
    "multilevelRule": "a child item becomes a subassembly when it owns an effective BOM definition; multi-level explosion follows itemMasterId references",
    "legacyCompatibilityRule": "legacy flat components remain valid and can be upgraded through TyanaBom.migrateLegacyComponents without changing the saved snapshot",
    "operationAssignmentRule": "assemblyOperationCode optionally references the shared operation-code library; operation routing remains independent from material identity",
    "parentRule": "parentId references a component id or FINISHED_GOOD",
    "positionRule": "position is unique among siblings",
    "alternativeSelectionRule": "exactly-one-per-parent-and-alternativeGroupId",
    "processReferenceRule": "all canonical process fields reference seed-processes.json ids",
    "reusableItemRule": "catalogItemId plus catalogRevision and reuseMode=reference",
    "canonicalProcessFields": [
      "producedAtProcessId",
      "firstUseProcessId",
      "mountedAtProcessId",
      "inspectedAtProcessId",
      "prerequisiteProcessId",
      "nextProcessId"
    ]
  },
