{
  "name": "tyana-qflow-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "build": "node build.mjs",
    "desktop:assets": "node desktop-build.mjs",
    "desktop:icon": "tauri icon qflow-icon.svg --output src-tauri/icons",
    "desktop:release:x64": "tauri build --ci --bundles nsis --target x86_64-pc-windows-msvc",
    "desktop:package:x64": "node release-package.mjs",
    "test:worker": "node tests/worker-smoke.mjs",
    "test:exports": "node tests/export-smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "pdfmake": "0.2.20"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
