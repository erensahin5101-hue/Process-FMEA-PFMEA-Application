{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TYANA Q-Flow",
  "version": "1.0.0",
  "identifier": "com.tyanaotomotiv.qflow",
  "build": {
    "beforeDevCommand": "node desktop-build.mjs",
    "beforeBuildCommand": "node desktop-build.mjs",
    "frontendDist": "../desktop-dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TYANA OTOMOTİV | Kalite Dokümantasyonu",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "category": "Business",
    "publisher": "TYANA OTOMOTİV",
    "copyright": "Copyright © 2026 TYANA OTOMOTİV. Tüm hakları saklıdır.",
    "shortDescription": "Otomotiv kalite dokumantasyonu ve kontrollu cikti sistemi",
    "longDescription": "Kontrol planı, proses akışı, PFMEA, operatör talimatı ve ürün teknik dokümantasyonu hazırlama sistemi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "startMenuFolder": "TYANA OTOMOTİV",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
